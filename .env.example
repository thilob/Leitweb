# Diesen Inhalt in Dockhand unter den Environment-/Stack-Variablen einfügen.
# Keine echten Zugangsdaten in das Git-Repository committen.

# Nach dem ersten Start muss dieses Passwort unverändert zum PostgreSQL-Volume
# gehören. Keine Semikolons oder führenden/nachgestellten Leerzeichen verwenden.
POSTGRES_PASSWORD=CHANGE-ME-long-random-database-password

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE-ME-different-long-random-admin-password

# Secret des vertraulichen Keycloak-Clients "leitweb-user-admin".
# Der Stack startet ohne diesen Wert; die Benutzeranlage antwortet dann mit HTTP 503.
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE-ME-keycloak-service-account-secret

# Öffentliche, vom Browser erreichbare Basis-URL ohne abschließenden Schrägstrich.
# Für einen entfernten Docker-Host NICHT localhost verwenden.
KEYCLOAK_PUBLIC_URL=http://SERVER-IP-ODER-DNS-NAME:8080

# Auf dem Docker-Host veröffentlichte Ports.
LEITWEB_PORT=5000
KEYCLOAK_PORT=8080
QGIS_PORT=8090

# QGIS Server verwendet diese Werte für Protokollierung und PostgreSQL.
QGIS_SERVER_LOG_LEVEL=1
POSTGRES_SSLMODE=prefer

# Bei externem HTTPS-Betrieb auf true setzen.
REQUIRE_HTTPS_METADATA=false

# Beispieldaten beim ersten Start anlegen.
INITIAL_DATA_SEED=true
