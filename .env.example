POSTGRES_PASSWORD=replace-with-a-long-random-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-different-long-random-password
# Vom Browser aus erreichbare Basis-URL des Keycloak-Dienstes.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
LEITWEB_PORT=5000
KEYCLOAK_PORT=8080
REQUIRE_HTTPS_METADATA=false
INITIAL_DATA_SEED=true
